// ─── Swrap — Prisma Schema ────────────────────────────────────────────────────
//
// PostgreSQL is the INDEX LAYER ONLY. It is non-authoritative and reconstructable.
// All meaningful data lives on Walrus. This schema stores only references and metadata.
//
// Key invariants (see ENGINEERING_RULES.md):
//   - Every Submission row MUST have a walrusBlobId before it is considered persisted.
//   - Every Form row MUST have a schemaBlobId before the form is considered published.
//   - Slugs are unique and immutable after publication.
//   - Submission rows are never updated — status changes are append-only log entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  owner
  admin
  viewer
}

enum FormMode {
  conversational
  table
}

enum EncryptionMode {
  none
  field_level
  full_submission
}

enum SubmissionStatus {
  open
  under_review
  planned
  resolved
  rejected
}

enum BlobType {
  form_schema
  submission
  file_upload
  encrypted_field
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forms              Form[]
  submissionStatuses SubmissionStatusLog[]
  creditTransactions CreditTransaction[]
  storageCredit      StorageCredit?

  @@map("app_users")
}

model Form {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String?
  ownerId        String
  schemaBlobId   String?        // Walrus blob ID for the form schema — null until published
  draftSchema    Json?          // Full form schema JSON for draft persistence (fields included)
  mode           FormMode       @default(table)
  encryptionMode EncryptionMode @default(none)
  sealPolicyId   String?        // Seal policy ID for encrypted forms
  isPublished    Boolean        @default(false)
  publishedAt    DateTime?
  publishStatus  String?        @default("draft")
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submissions Submission[]
  blobRefs    BlobReference[]

  @@map("app_forms")
}

model Submission {
  id           String           @id @default(cuid())
  formId       String
  walrusBlobId String           @unique // Canonical identifier — must always be set
  status       SubmissionStatus @default(open)
  submittedAt  DateTime         @default(now())

  form       Form                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  statusLogs SubmissionStatusLog[]
  blobRefs   BlobReference[]

  @@map("app_submissions")
}

model SubmissionStatusLog {
  id           String           @id @default(cuid())
  submissionId String
  adminId      String
  status       SubmissionStatus
  note         String?
  createdAt    DateTime         @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  admin      User       @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("app_submission_status_logs")
}

model BlobReference {
  id           String   @id @default(cuid())
  walrusBlobId String   @unique
  blobType     BlobType
  sizeBytes    Int?
  formId       String?
  submissionId String?
  createdAt    DateTime @default(now())

  form       Form?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@map("app_blob_references")
}

model StorageCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("app_storage_credits")
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  creditId     String
  amount       Float    // positive = deposit, negative = deduction
  type         String   // 'deposit' | 'deduction'
  walrusBlobId String?  // blob that triggered the deduction (if applicable)
  description  String?
  createdAt    DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credit StorageCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("app_credit_transactions")
}

// ─── Core Standalone API Models (mapped to raw node-pg-migrate tables) ──────────

model DbUser {
  address      String   @id
  signerKind   String   @map("signer_kind")
  displayName  String?  @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  forms        DbForm[]
  submissions  DbSubmission[]
  uploadJobs   DbUploadJob[]

  @@map("users")
}

model DbForm {
  id            String   @id @db.Uuid
  ownerAddress  String   @map("owner_address")
  walrusBlobId  String   @unique @map("walrus_blob_id")
  privacyMode   String   @map("privacy_mode")
  policyId      String?  @map("policy_id")
  version       Int      @default(1)
  predecessorId String?  @map("predecessor_id") @db.Uuid
  state         String
  contentDigest String?  @map("content_digest")
  sizeBytes     BigInt?  @default(0) @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner         DbUser         @relation(fields: [ownerAddress], references: [address])
  predecessor   DbForm?        @relation("FormVersions", fields: [predecessorId], references: [id])
  successors    DbForm[]       @relation("FormVersions")
  submissions   DbSubmission[]
  permissions   DbPermission[]

  @@map("forms")
}

model DbSubmission {
  id               String   @id @db.Uuid
  formId           String   @map("form_id") @db.Uuid
  formVersion      Int      @map("form_version")
  submitterAddress String   @map("submitter_address")
  walrusBlobId     String   @unique @map("walrus_blob_id")
  privacyMode      String   @map("privacy_mode")
  contentDigest    String   @map("content_digest")
  sizeBytes        BigInt   @map("size_bytes")
  state            String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  form             DbForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitter        DbUser   @relation(fields: [submitterAddress], references: [address])
  files            DbFile[]

  @@unique([formId, walrusBlobId])
  @@map("submissions")
}

model DbFile {
  id            String   @id @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  walrusBlobId  String   @unique @map("walrus_blob_id")
  contentType   String   @map("content_type")
  sizeBytes     BigInt   @map("size_bytes")
  contentDigest String   @map("content_digest")
  state         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  submission    DbSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("files")
}

model DbUploadJob {
  id            String   @id @db.Uuid
  ownerAddress  String   @map("owner_address")
  artifactKind  String   @map("artifact_kind")
  artifactId    String?  @map("artifact_id") @db.Uuid
  walrusBlobId  String?  @map("walrus_blob_id")
  state         String
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  owner         DbUser   @relation(fields: [ownerAddress], references: [address])

  @@unique([ownerAddress, walrusBlobId])
  @@map("upload_jobs")
}

model DbActivity {
  id           BigInt   @id @default(autoincrement())
  requestId    String   @map("request_id")
  actorAddress String?  @map("actor_address")
  action       String
  targetKind   String?  @map("target_kind")
  targetId     String?  @map("target_id") @db.Uuid
  outcome      String
  httpStatus   Int?     @map("http_status")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("activity")
}

model DbPermission {
  id               String   @id @db.Uuid
  formId           String   @map("form_id") @db.Uuid
  granteeAddress   String   @map("grantee_address")
  capability       String
  grantedByAddress String   @map("granted_by_address")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  form             DbForm   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, granteeAddress, capability])
  @@map("permissions")
}
