# =============================================================================
# SEALBASE — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string (index layer only — not canonical data store)
DATABASE_URL="postgresql://user:password@localhost:5432/sealbase"

# -----------------------------------------------------------------------------
# Authentication (NextAuth v5 + Firebase)
# -----------------------------------------------------------------------------
# Secret used to sign session tokens — generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"

# The canonical URL of your deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Firebase Admin SDK — service account key as a single-line JSON string
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON content as one line here.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# -----------------------------------------------------------------------------
# Walrus Decentralized Storage
# -----------------------------------------------------------------------------
# Walrus aggregator endpoint (for reads)
WALRUS_AGGREGATOR_URL="https://aggregator.walrus-testnet.walrus.space"

# Walrus publisher endpoint (for writes)
WALRUS_PUBLISHER_URL="https://publisher.walrus-testnet.walrus.space"

# -----------------------------------------------------------------------------
# Seal Encryption
# -----------------------------------------------------------------------------
# Seal API endpoint for encryption/decryption operations
SEAL_API_URL="https://seal-api.example.com"

# -----------------------------------------------------------------------------
# Infrastructure Wallet
# -----------------------------------------------------------------------------
# Private key for the SEALBASE infrastructure wallet that executes all
# Walrus and Seal operations on behalf of users.
# WARNING: Never log, expose in API responses, or commit this value.
INFRA_WALLET_PRIVATE_KEY="your-infrastructure-wallet-private-key"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The public-facing URL of the application (used for generating form URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Walrus Testnet POC ────────────────────────────────────────────────────────
# Feature flags and endpoints for the Walrus Testnet proof-of-concept.
# These are additive — they do not affect the production code paths.
# Copy the values below into your .env.local when working on the POC branch.
# ─────────────────────────────────────────────────────────────────────────────

# Skip production storage-credit checks (set false before any real deployment)
DEV_BYPASS_STORAGE=true

# Use the local Sui CLI keypair (~/.sui/sui_config/) instead of INFRA_WALLET_PRIVATE_KEY
DEV_LOCAL_SIGNER=true

# Require encrypted blobs on all upload paths.
# Keep false in production; set true only for plaintext dev/testing.
DEV_ALLOW_PLAINTEXT=false

# Target Walrus testnet publisher/aggregator endpoints (set false to use mainnet)
USE_WALRUS_TESTNET=true

# Target Sui testnet RPC (set false to use mainnet)
USE_SUI_TESTNET=true

# Walrus publisher endpoint used by the POC upload path
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# Walrus aggregator endpoint used by the POC download path
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Sui fullnode RPC used by the POC signer and transaction execution
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# On-chain package ID — leave empty until Phase 6 (`sui client publish`)
SUI_POC_PACKAGE_ID=
