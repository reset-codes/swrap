# =============================================================================
# Swrap — Production Deployment Environment Variables
# =============================================================================
# Copy this file to .env.deploy and fill in all values before deploying.
# NEVER commit .env.deploy to version control.
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # Edit .env.deploy with real values
#   docker compose -f docker-compose.prod.yml --env-file .env.deploy up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Strong random password for the Postgres swrap user.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-random-password

# -----------------------------------------------------------------------------
# Infrastructure Wallet
# -----------------------------------------------------------------------------
# bech32-encoded Sui private key for the Infrastructure_Wallet.
# This wallet owns all Seal encryption/decryption authority.
# Load from a secrets manager in production — never hardcode.
# Generate a dedicated wallet: sui keytool generate ed25519
# WARNING: Never log, expose in API responses, or commit this value.
INFRASTRUCTURE_WALLET_SECRET=suiprivkey1...

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Secret used to sign session tokens. Must be at least 32 characters.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-chars-random

# -----------------------------------------------------------------------------
# API Security
# -----------------------------------------------------------------------------
# Bearer token for admin/internal API routes.
# Generate: openssl rand -base64 32
API_SECRET_KEY=change-me-strong-random-api-key

# Comma-separated list of allowed CORS origins. No wildcards in production.
# Example: https://swrap.example.com
API_CORS_ORIGINS=https://your-domain.example.com

# -----------------------------------------------------------------------------
# Walrus Storage
# -----------------------------------------------------------------------------
# Walrus aggregator endpoint (for reads)
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Walrus publisher endpoint (for writes)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# -----------------------------------------------------------------------------
# Sui Network
# -----------------------------------------------------------------------------
# Sui fullnode RPC URL
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# -----------------------------------------------------------------------------
# Web App (Next.js public vars — baked into the image at build time)
# -----------------------------------------------------------------------------
# The public-facing URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# The public-facing URL of the API (no trailing slash)
# Typically the same domain with /api prefix handled by nginx
NEXT_PUBLIC_API_URL=https://your-domain.example.com/api

# Firebase client-side config (safe to expose — these are public API keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# NextAuth (web service runtime vars)
# -----------------------------------------------------------------------------
# The canonical URL of your deployment (no trailing slash)
NEXTAUTH_URL=https://your-domain.example.com

# Secret used to sign NextAuth session tokens — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-strong-random-nextauth-secret

# Firebase Admin SDK — service account key as a single-line JSON string
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# Forbidden vars — these MUST NOT be present in production:
#   DEV_BYPASS_STORAGE     — legacy POC flag, causes startup failure if set
#   DEV_LOCAL_SIGNER       — legacy POC flag, causes startup failure if set
#   DEV_ALLOW_PLAINTEXT    — legacy POC flag, causes startup failure if set
#   INFRA_WALLET_PRIVATE_KEY — renamed to INFRASTRUCTURE_WALLET_SECRET
