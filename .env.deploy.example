# =============================================================================
# Swrap — VPS API Deployment Environment Variables
# =============================================================================
# Copy this file to .env.deploy and fill in all values before deploying.
# NEVER commit .env.deploy to version control.
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # Edit .env.deploy with real values
#   docker compose -f docker-compose.vps.yml --env-file .env.deploy up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Strong random password for the Postgres swrap user.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-random-password
POSTGRES_DB=swrap
POSTGRES_USER=swrap

# -----------------------------------------------------------------------------
# Infrastructure Wallet
# -----------------------------------------------------------------------------
# bech32-encoded Sui private key for the Infrastructure_Wallet.
# This wallet owns all Seal encryption/decryption authority.
# Generate a dedicated wallet: sui keytool generate ed25519
# WARNING: Never log, expose in API responses, or commit this value.
INFRASTRUCTURE_WALLET_SECRET=suiprivkey1...

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Secret used to sign session tokens. Must be at least 32 characters.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-chars-random

# -----------------------------------------------------------------------------
# API Security
# -----------------------------------------------------------------------------
# Bearer token for admin/internal API routes.
# Generate: openssl rand -base64 32
API_SECRET_KEY=change-me-strong-random-api-key

# Comma-separated list of allowed CORS origins.
# Must include your Vercel frontend URL(s). No wildcards in production.
API_CORS_ORIGINS=https://swrap.tech,https://www.swrap.tech

# -----------------------------------------------------------------------------
# Walrus Storage (Testnet)
# -----------------------------------------------------------------------------
# Walrus aggregator endpoint (for reads)
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Walrus publisher endpoint (for writes)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# -----------------------------------------------------------------------------
# Sui Network (Testnet)
# -----------------------------------------------------------------------------
# Sui fullnode RPC URL
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# =============================================================================
# VERCEL ENVIRONMENT VARIABLES (set in Vercel Dashboard, not on VPS)
# =============================================================================
# These are listed here for reference only. Set them in Vercel project settings.
#
# NEXT_PUBLIC_APP_URL=https://swrap.tech
# NEXT_PUBLIC_API_URL=https://api.swrap.tech
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=...
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
# NEXT_PUBLIC_FIREBASE_APP_ID=...
# NEXTAUTH_URL=https://swrap.tech
# NEXTAUTH_SECRET=...
# FIREBASE_SERVICE_ACCOUNT_KEY=...
# DATABASE_URL=postgresql://swrap:<password>@168.144.95.178:5432/swrap
#
# NOTE: If your Vercel frontend needs direct DB access (for NextAuth/Prisma),
# you'll need to expose PostgreSQL port 5432 on the VPS or use a connection
# pooler like PgBouncer. See deploy/README.md for details.
# =============================================================================

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# Forbidden vars — these MUST NOT be present in production:
#   DEV_BYPASS_STORAGE     — legacy POC flag, causes startup failure if set
#   DEV_LOCAL_SIGNER       — legacy POC flag, causes startup failure if set
#   DEV_ALLOW_PLAINTEXT    — legacy POC flag, causes startup failure if set
#   INFRA_WALLET_PRIVATE_KEY — renamed to INFRASTRUCTURE_WALLET_SECRET
